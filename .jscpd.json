{
  "path": [
    "apps/web/src",
    "apps/desktop/src",
    "apps/desktop/scripts",
    "packages/ui/src",
    "packages/contracts/src",
    "tools/extract",
    "tools/compress"
  ],
  "format": ["typescript", "tsx", "javascript"],
  "ignore": ["**/routeTree.gen.ts", "packages/ui/src/components/**"],
  "minTokens": 50,
  "minLines": 3,
  "similarity": 0.8,
  "reporters": ["console"],
  "exitCode": 1
}
