              },
              {
                "group": ["react", "react-dom", "@react-three/*", "zustand", "sonner", "@workspace/ui/*"],
                "message": "domain/ is the game's data model: pure TypeScript + Effect, no renderer, UI or app layers. (Tests may use three.js to check the frame mapping.)"
              },
              {
                "regex": "(^|/)repos/",
                "message": "repos/ is vendored reference material; import the npm package instead."
              }
            ]
