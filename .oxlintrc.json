{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc", "eslint", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": { "typeAware": true },
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": [
    "repos/**",
    "samples/**",
    "assets/**",
    "tools/**/*.mjs",
    "**/dist-electron/**",
    "**/routeTree.gen.ts"
  ],
  "rules": {
    // typescript-eslint strict-type-checked, minus what tsc already covers
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    "typescript/restrict-template-expressions": ["error", { "allowNumber": true }],
    // Schema.Opaque classes are plain structs typed as classes; spreading them is how edits work.
    "typescript/no-misused-spread": ["error", {
      "allow": [
        {
          "from": "file",
          "path": "src/domain/MapFile.ts",
          "name": [
            "Vector3",
            "Quat",
            "ItemTransform",
            "MaterialSlot",
            "MeshComponent",
            "Item",
            "LevelData",
            "WorldSettings",
            "ItemPivot",
            "EditorState",
            "MapFile"
          ]
        },
        {
          "from": "file",
          "path": "src/domain/Catalog.ts",
          "name": [
            "Bounds",
            "CatalogMaterialSlot",
            "Rotator",
            "MainRelativeTransform",
            "ExtraMesh",
            "CatalogPiece",
            "CatalogMesh",
            "Catalog"
          ]
        }
      ]
    }],
    "typescript/no-deprecated": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    // stylistic-type-checked
    "typescript/prefer-optional-chain": "error",
    // `a || b` on strings deliberately treats "" as missing.
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    "typescript/prefer-includes": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/no-import-type-side-effects": "error",

    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",

    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/first": "error",
    // Stylesheets are imported for their side effect (main.tsx's globals.css).
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],

    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-abusive-eslint-disable": "error",

    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "(^|/)repos/",
            "message": "repos/ is vendored reference material; import the npm package instead."
          }
        ]
      }
    ],
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expectVec", "assert", "assert.*"] }],

    // Off, as in Effect's own oxlintrc: `_tag` is the Effect discriminant; local
    // helpers in components/tests read better next to their use; sort() on fresh arrays is fine.
    "eslint/no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "oxc/no-map-spread": "off",
    // tsc's noImplicitReturns covers this and understands exhaustive switches; effects
    // that return a cleanup on some paths only are normal React.
    "typescript/consistent-return": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/test/**"],
      "rules": { "typescript/no-non-null-assertion": "off" }
    },
    {
      // react-three-fiber scene components mutate three objects in effects and useFrame by design.
      "files": ["apps/web/src/editor/**/*.tsx"],
      "rules": { "react/immutability": "off" }
    },
    {
      // shadcn-generated; kept as upstream ships it so `shadcn add` updates apply cleanly.
      "files": ["packages/ui/src/components/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "react/jsx-no-constructed-context-values": "off"
      }
    },
    // apps/web is the renderer for both the web build and the desktop app.
    {
      "files": ["apps/web/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["electron", "electron/*", "@ballest/desktop", "@ballest/desktop/*"],
                "message": "apps/web also runs in a browser: reach the desktop through window.ballest (DesktopBridge in @ballest/contracts)."
              },
              {
                "regex": "^(\\.\\./)+(apps/)?desktop(/|$)",
                "message": "apps/web also runs in a browser: reach the desktop through window.ballest (DesktopBridge in @ballest/contracts)."
              },
              {
                "regex": "(^|/)repos/",
                "message": "repos/ is vendored reference material; import the npm package instead."
              }
            ]
          }
        ]
      }
    },
    // Shared by the main process, the sandboxed preload and the renderer: schemas and types over effect, nothing else.
    {
      "files": ["packages/contracts/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "electron",
                  "electron/*",
                  "@ballest/*",
                  "@workspace/*",
                  "react",
                  "react/*",
                  "three",
                  "three/*"
                ],
                "message": "@ballest/contracts depends on effect only; main, preload and renderer all import it."
              },
              {
                "regex": "^node:",
                "message": "@ballest/contracts depends on effect only; main, preload and renderer all import it."
              },
              {
                "regex": "^(\\.\\./)+(apps|packages)/",
                "message": "@ballest/contracts depends on effect only; main, preload and renderer all import it."
              },
              {
                "regex": "(^|/)repos/",
                "message": "repos/ is vendored reference material; import the npm package instead."
              }
            ]
          }
        ]
      }
    },
    // Module boundaries: domain <- services <- editor <- components <- routes; ui knows none of them.
    {
      "files": ["apps/web/src/domain/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["electron", "electron/*", "@ballest/desktop", "@ballest/desktop/*"],
                "message": "apps/web also runs in a browser: reach the desktop through window.ballest (DesktopBridge in @ballest/contracts)."
              },
              {
                "regex": "^(\\.\\./)+(apps/)?desktop(/|$)",
                "message": "apps/web also runs in a browser: reach the desktop through window.ballest (DesktopBridge in @ballest/contracts)."
              },
              {
                "regex": "^(@/|(\\.\\.?/)+([\\w.-]+/)*)editor(/|$)",
                "message": "domain/ is the game's data model: pure TypeScript + Effect, no renderer, UI or app layers."
              },
              {
                "regex": "^(@/|(\\.\\.?/)+([\\w.-]+/)*)services(/|$)",
                "message": "domain/ is the game's data model: pure TypeScript + Effect, no renderer, UI or app layers."
              },
              {
                "regex": "^(@/|(\\.\\.?/)+([\\w.-]+/)*)components(/|$)",
                "message": "domain/ is the game's data model: pure TypeScript + Effect, no renderer, UI or app layers."
              },
              {
                "regex": "^(@/|(\\.\\.?/)+([\\w.-]+/)*)routes(/|$)",
                "message": "domain/ is the game's data model: pure TypeScript + Effect, no renderer, UI or app layers."
              },
              {
                "group": ["react", "react-dom", "react/*"],
                "message": "domain/ is the game's data model: pure TypeScript + Effect, no renderer, UI or app layers."
              },
              {
                "group": ["three", "three/*", "@react-three/*"],
                "message": "domain/ is the game's data model: pure TypeScript + Effect, no renderer, UI or app layers."
              },
              {
                "group": ["zustand", "sonner", "@workspace/ui/*", "@tanstack/*"],
                "message": "domain/ is the game's data model: pure TypeScript + Effect, no renderer, UI or app layers."
              },
              {
                "regex": "(^|/)repos/",
                "message": "repos/ is vendored reference material; import the npm package instead."
              },
              { "regex": "^(@/|(\\.\\.?/)+([\\w.-]+/)*)test(/|$)", "message": "src/test/ helpers are for tests only." },
              {
                "regex": "^node:",
                "message": "Editor source runs in the browser; node: builtins are for tests and tooling."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/domain/**/*.test.ts"],
