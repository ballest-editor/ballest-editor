{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "repos/**"
  ],
  "ignoreExportsUsedInFile": true,
  // System binaries tools/compress runs: avifenc from the Nix dev shell, else nix to build it from the flake.
  "ignoreBinaries": ["avifenc", "nix"],
  "workspaces": {
    ".": {
      "entry": [
        "tools/compress/*.mjs",
        ".claude/skills/*/scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "@effect/language-service"
      ]
    },
    "apps/web": {
      // Read by tools/app-driver and the coverage test, never imported by the app.
      "entry": ["src/**/*.states.ts"],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "apps/desktop": {
      // dev-electron.ts is spawned by vite.config.ts in watch mode.
      "entry": ["src/main.ts", "src/preload.ts", "scripts/dev-electron.ts"]
    },
    "packages/contracts": {},
    "tools/dev": {},
    "packages/ui": {},
    "tools/extract": {
      "entry": ["*.mjs"],
      // The connector tests import the editor's domain code by path, as tools/map does.
      "ignoreDependencies": ["@ballest/web"]
    },
    "tools/release": {},
    "tools/driver": {},
    "tools/map": {
      // Imported by path; the dependency is what makes turbo rebuild this tool's hash when the domain code changes.
      "ignoreDependencies": ["@ballest/web"]
    },
    "tools/app-driver": {},
    "packages/ballest-driver": {}
  }
}
