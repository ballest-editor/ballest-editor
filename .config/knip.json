{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "repos/**"
  ],
  "ignoreExportsUsedInFile": true,
  // System binaries tools/compress runs: avifenc from the Nix dev shell, else nix to build it from the flake.
  "ignoreBinaries": ["avifenc", "nix"],
  "workspaces": {
    ".": {
      "entry": [
        "tools/compress/*.mjs"
      ],
      "ignoreDependencies": [
        "@effect/language-service"
      ]
    },
    "apps/web": {
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "apps/desktop": {
      // dev-electron.ts is spawned by vite.config.ts in watch mode.
      "entry": ["src/main.ts", "src/preload.ts", "scripts/dev-electron.ts"]
    },
    "packages/contracts": {},
    "tools/dev": {},
    "packages/ui": {},
    "tools/extract": {
      "entry": ["src/main.ts", "*.mjs"]
    },
    "tools/release": {}
  }
}
