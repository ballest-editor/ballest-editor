<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Ballest piece extractor. Built by tools/extract/run.sh, which copies this
    directory next to a pinned CUE4Parse checkout (flake input `cue4parse`) in a
    writable work dir. Override the CUE4Parse location with -p:Cue4ParseDir=...
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Cue4ParseDir Condition="'$(Cue4ParseDir)' == ''">$(MSBuildThisFileDirectory)../CUE4Parse</Cue4ParseDir>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Cue4ParseDir)/CUE4Parse/CUE4Parse.csproj" />
    <!-- texture decoding (managed AssetRipper BCn path) + ImageSharp PNG encoding -->
    <ProjectReference Include="$(Cue4ParseDir)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>
</Project>
