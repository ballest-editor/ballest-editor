    "meshoptimizer": "1.1.1"
  },
  "devDependencies": {
    "@ballest/web": "workspace:*",
    "@effect/vitest": "^4.0.6",
    "@types/node": "^22.20.5",
    "vitest": "^5.0.5"
  }
}
