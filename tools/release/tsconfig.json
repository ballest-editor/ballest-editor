{
  "extends": "../../.config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // Run directly by node (type stripping), so imports name the .ts files.
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "schemaClassMissingBrand": "off" },
        // A command-line tool: the platform services are what it is made of.
        "allowedUnstableApis": [
          "@effect/vitest",
          "@effect/platform-node",
          "effect/FileSystem",
          "effect/Path",
          "effect/process",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner",
          "effect/cli"
        ],
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false
      }
    ]
  },
  "include": ["src", "vitest.config.ts"]
}
