{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "cacheDir": "node_modules/.cache/turbo",
  "tasks": {
    // No script: lets a package's hash include its dependencies' sources without
    // waiting for their tasks (typecheck/test run in parallel across packages).
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/samples/**",
        "$TURBO_ROOT$/assets/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "//#assets"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        ".env*",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/web-assets/**"
      ],
      "outputs": ["dist/**"]
    },
    // The desktop app packages the renderer build and the assets, so it builds after both.
    "@ballest/desktop#build": {
      "dependsOn": ["^build", "@ballest/web#build", "//#assets"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist-electron/**"]
    },
    "dev": {
      "dependsOn": ["//#assets"],
      "cache": false,
      "persistent": true
    },

    // Repo-wide tools, run once from the root.
    // tools/compress: the extractor's raw meshes and textures -> web-assets/ (gitignored). Where they are absent
    // (CI, Vercel, a fresh clone) it downloads the asset pack web-assets.json points at instead.
    "//#assets": {
      "inputs": [
        "tools/compress/compress.mjs",
        "tools/compress/download.mjs",
        "tools/compress/pack.mjs",
        "web-assets.json",
        "assets/pieces/**",
        "assets/textures/**"
      ],
      "outputs": ["web-assets/**"]
    },
    "//#lint": {
      "inputs": [
        ".oxlintrc.json",
        "tsconfig.base.json",
        "pnpm-lock.yaml",
        "apps/*/tsconfig.json",
        "packages/*/tsconfig.json",
        "tools/*/tsconfig.json",
        "apps/**/*.{ts,tsx,js,mjs}",
        "packages/**/*.{ts,tsx,js,mjs}",
        "tools/**/*.ts",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/dist-electron/**"
      ]
    },
    "//#knip": {
      "inputs": [
        "knip.json",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.base.json",
        "*.config.{js,mjs,ts}",
        ".husky/*",
        ".github/workflows/**",
        "apps/**",
        "packages/**",
        "tools/extract/**",
        "tools/compress/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/dist-electron/**"
      ]
    },
    "//#dupes": {
      "inputs": [
        ".jscpd.json",
        "apps/web/src/**",
        "apps/desktop/src/**",
        "packages/ui/src/**",
        "packages/contracts/src/**",
        "tools/extract/**",
        "tools/compress/**"
      ]
    },
    "//#format:check": {
      "inputs": [
        "dprint.json",
        "**/*.{ts,tsx,js,mjs,json,md}",
        "!repos/**",
        "!samples/**",
        "!assets/**",
        "!web-assets/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/dist-electron/**"
      ]
    }
  }
}
