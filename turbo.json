{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "cacheDir": "node_modules/.cache/turbo",
  "tasks": {
    // No script: lets a package's hash include its dependencies' sources without
    // waiting for their tasks (typecheck/test run in parallel across packages).
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/samples/**",
        "$TURBO_ROOT$/assets/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "//#assets"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        ".env*",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/web-assets/**",
        "$TURBO_ROOT$/web-assets.json"
      ],
      // Nitro picks its deploy preset from these (VERCEL=1 → .vercel/output, else .output).
      "env": ["VERCEL", "NITRO_PRESET"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"]
    },
    "dev": {
      "dependsOn": ["//#assets"],
      "cache": false,
      "persistent": true
    },

    // Repo-wide tools, run once from the root.
    // tools/compress: the extractor's raw meshes and textures -> web-assets/ (gitignored; absent on CI and Vercel).
    "//#assets": {
      "inputs": ["tools/compress/compress.mjs", "assets/pieces/**", "assets/textures/**"],
      "outputs": ["web-assets/**"]
    },
    "//#lint": {
      "inputs": [
        ".oxlintrc.json",
        "tsconfig.base.json",
        "pnpm-lock.yaml",
        "apps/*/tsconfig.json",
        "packages/*/tsconfig.json",
        "apps/**/*.{ts,tsx,js,mjs}",
        "packages/**/*.{ts,tsx,js,mjs}",
        "!**/node_modules/**",
        "!**/dist/**"
      ]
    },
    "//#knip": {
      "inputs": [
        "knip.json",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.base.json",
        "*.config.{js,mjs,ts}",
        ".husky/*",
        ".github/workflows/**",
        "apps/**",
        "packages/**",
        "tools/extract/**",
        "tools/compress/**",
        "!**/node_modules/**",
        "!**/dist/**"
      ]
    },
    "//#dupes": {
      "inputs": [".jscpd.json", "apps/editor/src/**", "packages/ui/src/**", "tools/extract/**", "tools/compress/**"]
    },
    "//#format:check": {
      "inputs": [
        "dprint.json",
        "**/*.{ts,tsx,js,mjs,json,md}",
        "!repos/**",
        "!samples/**",
        "!assets/**",
        "!web-assets/**",
        "!**/node_modules/**",
        "!**/dist/**"
      ]
    }
  }
}
