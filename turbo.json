{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "cacheDir": "node_modules/.cache/turbo",
  // Vercel Remote Cache, shared by CI and every machine with a token: TURBO_TOKEN in CI, `turbo login` locally.
  // Without a token turbo uses only the local cache.
  "remoteCache": { "teamId": "team_Gzvt95jCGuNmUHVYHwN7N7K6" },
  "tasks": {
    // No script: lets a package's hash include its dependencies' sources without
    // waiting for their tasks (typecheck/test run in parallel across packages).
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.config/tsconfig.base.json"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.config/tsconfig.base.json",
        "$TURBO_ROOT$/.config/vitest.ts",
        "$TURBO_ROOT$/samples/**",
        "$TURBO_ROOT$/assets/**"
      ]
    },
    "build": {
      "dependsOn": ["^build", "//#assets"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.config/tsconfig.base.json",
        ".env*",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/web-assets/**"
      ],
      // The commit About shows, where the checkout has no history (apps/web/build/buildFacts.ts).
      "passThroughEnv": ["VERCEL_GIT_COMMIT_SHA"],
      "outputs": ["dist/**"]
    },
    // The connector tests read the piece meshes (tools/extract/src/connectorMeshes.test.ts), so they wait for them.
    "@ballest/extract#test": {
      "dependsOn": ["transit", "//#assets"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.config/tsconfig.base.json",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/web-assets/pieces/**"
      ]
    },
    // The desktop app packages the renderer build, the assets and the editor-link plugin, so it builds after them.
    "@ballest/desktop#build": {
      "dependsOn": ["^build", "@ballest/web#build", "@ballest/editor-link#build", "//#assets"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.config/tsconfig.base.json"],
      "outputs": ["dist-electron/**"]
    },
    // Copies info.toml and main.as into dist/ballest-editor-link/; needs none of the game assets.
    "@ballest/editor-link#build": {
      "outputs": ["dist/**"]
    },
    // The same for the driver's plugin, dist/ballest-driver/, which `pnpm driver setup` installs into the game copy.
    "@ballest/driver-plugin#build": {
      "outputs": ["dist/**"]
    },
    // Run through tools/dev/src/dev-runner.ts (`pnpm dev`, `pnpm dev:desktop`), which sets PORT, HOST and
    // VITE_DEV_SERVER_URL and passes --env-mode=loose so they reach the tasks.
    "dev": {
      "dependsOn": ["//#assets"],
      "cache": false,
      "persistent": true
    },
    // Unpackaged, the desktop app installs the plugin from packages/ballest-editor-link/dist.
    "@ballest/desktop#dev": {
      "dependsOn": ["//#assets", "@ballest/editor-link#build"],
      "cache": false,
      "persistent": true
    },

    // Repo-wide tools, run once from the root.
    // tools/compress: the extractor's raw meshes and textures -> web-assets/ (gitignored). Where they are absent
    // (CI, Vercel, a fresh clone) it downloads the asset pack tools/compress/web-assets.json points at instead.
    "//#assets": {
      "inputs": [
        "tools/compress/compress.mjs",
        "tools/compress/download.mjs",
        "tools/compress/pack.mjs",
        "tools/compress/web-assets.json",
        "assets/pieces/**",
        "assets/textures/**"
      ],
      "outputs": ["web-assets/**"]
    },
    "//#lint": {
      "inputs": [
        ".config/oxlintrc.json",
        "package.json",
        ".config/tsconfig.base.json",
        "pnpm-lock.yaml",
        "apps/*/tsconfig.json",
        "packages/*/tsconfig.json",
        "tools/*/tsconfig.json",
        "apps/**/*.{ts,tsx,js,mjs}",
        "packages/**/*.{ts,tsx,js,mjs}",
        "tools/**/*.ts",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/dist-electron/**"
      ]
    },
    "//#knip": {
      "inputs": [
        ".config/knip.json",
        "package.json",
        "pnpm-lock.yaml",
        ".config/tsconfig.base.json",
        "*.config.{js,mjs,ts}",
        ".husky/*",
        ".github/workflows/**",
        ".claude/skills/**",
        "apps/**",
        "packages/**",
        "tools/extract/**",
        "tools/compress/**",
        "tools/dev/**",
        "tools/release/**",
        "tools/driver/**",
        "tools/map/**",
        "tools/approximate/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/dist-electron/**"
      ]
    },
    "//#dupes": {
      "inputs": [
        ".config/jscpd.json",
        "apps/web/src/**",
        "apps/desktop/src/**",
        "apps/collect/src/**",
        "apps/collect/build/**",
        "apps/admin/src/**",
        "packages/ui/src/**",
        "packages/contracts/src/**",
        "tools/extract/**",
        "tools/compress/**",
        "tools/dev/src/**",
        "tools/release/src/**",
        "tools/driver/src/**",
        "tools/map/src/**",
        "tools/approximate/src/**"
      ]
    },
    "//#format:check": {
      "inputs": [
        "dprint.json",
        "**/*.{ts,tsx,js,mjs,json,md}",
        "!repos/**",
        "!samples/**",
        "!assets/**",
        "!web-assets/**",
        "!release/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/dist-electron/**"
      ]
    }
  }
}
