{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "electron"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "schemaClassMissingBrand": "off" },
        // The main process is a Node program: the platform services are what it is made of.
        "allowedUnstableApis": [
          "@effect/vitest",
          "@effect/platform-node",
          "effect/FileSystem",
          "effect/Path",
          "effect/http/Mime"
        ],
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false
      }
    ]
  },
  "include": ["src", "scripts", "vite.config.ts", "vitest.config.ts"]
}
