{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Bundles src/functions/ into Vercel's Build Output API (build/vercelBuild.ts); needs none of the game assets.
    // `transit` puts @ballest/contracts' sources in the hash.
    "build": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.config/tsconfig.base.json"],
      "outputs": [".vercel/output/**"]
    }
  }
}
