{
  "name": "@ballest/collect",
  "private": true,
  "type": "module",
  "description": "The public endpoint the desktop app sends feedback and usage statistics to (its own Vercel project)",
  "exports": {
    "./vercel": {
      "types": "./src/vercel.ts",
      "import": "./src/vercel.ts"
    }
  },
  "scripts": {
    "build": "node build/vercelBuild.ts api/feedback=src/functions/feedback.ts api/events=src/functions/events.ts",
    "typecheck": "effect-tsgo tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ballest/contracts": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "effect": "^4.0.6"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.5"
  }
}
