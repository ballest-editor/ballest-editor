{
  "name": "ballest-editor",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "oxlint --type-aware --deny-warnings --disable-nested-config",
    "knip": "knip --treat-config-hints-as-errors",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check:everything": "turbo run format:check lint knip dupes typecheck test build --continue",
    "dupes": "jscpd"
  },
  "devDependencies": {
    "@effect/tsgo": "0.61.0",
    "dprint": "0.64.3",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
