{
  "name": "ballest-editor",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node tools/dev/src/dev-runner.ts dev",
    "dev:desktop": "node tools/dev/src/dev-runner.ts dev:desktop",
    "build": "turbo build",
    "assets": "node tools/compress/compress.mjs && node tools/compress/download.mjs",
    "assets:publish": "node tools/compress/publish.mjs",
    "dist:desktop:win": "node tools/release/src/main.ts desktop --platform win",
    "dist:desktop:linux": "node tools/release/src/main.ts desktop --platform linux",
    "release:smoke": "node tools/release/src/main.ts smoke",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "oxlint --type-aware --deny-warnings --disable-nested-config",
    "knip": "knip --treat-config-hints-as-errors",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check:everything": "turbo run format:check lint knip dupes typecheck test build --continue",
    "dupes": "jscpd",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "0.61.0",
    "dprint": "0.64.3",
    "gltfpack": "1.2.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tar": "7.5.22",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": "dprint fmt --allow-no-files",
    "{apps,packages,tools}/**/*.{ts,tsx}": "oxlint --type-aware --deny-warnings --disable-nested-config"
  }
}
